[Unit]
Description=Stock Pro Odoo Backend
After=network.target

[Service]
Type=simple
User=gabriel
WorkingDirectory=/home/gabriel/Quiebra/backend
ExecStart=/home/gabriel/Quiebra/backend/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
